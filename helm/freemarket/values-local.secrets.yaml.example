# Local development credentials.
#
# Copy this file to values-local.secrets.yaml and fill in the values.
# values-local.secrets.yaml is gitignored — never commit it.
#
# Generate a JWT secret:
#   openssl rand -base64 64

credentials:
  postgresUser: admin
  postgresPassword: password
  jwtSecret: "REPLACE_ME_with_output_of: openssl rand -base64 64"
